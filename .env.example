# Which AI provider to use: "ollama" or "openrouter".
AI_PROVIDER=ollama

# OpenRouter (used when AI_PROVIDER=openrouter). Create a key at openrouter.ai.
# Model ids ending in ":free" cost nothing but have daily/per-minute limits.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Ollama API key. Required for Ollama Cloud (https://ollama.com); leave blank
# for a local Ollama install that doesn't require authentication.
OLLAMA_API_KEY=

# Ollama endpoint. Use http://localhost:11434 for a local install, or
# https://ollama.com for Ollama Cloud.
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for all structured AI calls (must be available to your
# Ollama endpoint/account).
OLLAMA_MODEL=gpt-oss:20b

# SQLite database location. Leave unset to use the default - an absolute
# path anchored to backend/nextstep.db regardless of the process's working
# directory. Only set this if you need a non-default location.
# DATABASE_URL=sqlite:////absolute/path/to/nextstep.db

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173

ENVIRONMENT=development
